# Public, non-secret build-time settings for the live site (ADR-032). Secrets never go here:
# they live in the hosting panel and .env.local. A value set in the hosting panel wins.
NEXT_PUBLIC_SITE_URL=https://globalmedtranscriptions.com
NEXT_PUBLIC_APP_URL=https://globalmedtranscriptions.com
NEXTAUTH_URL=https://globalmedtranscriptions.com
