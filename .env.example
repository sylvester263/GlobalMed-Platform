# ---------- App ----------
NEXT_PUBLIC_SITE_URL=https://globalmedtranscriptions.com
NEXT_PUBLIC_APP_NAME="GlobalMed"

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never NEXT_PUBLIC

# ---------- Video (Bunny Stream) ----------
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_AUTH_KEY=
BUNNY_CDN_HOSTNAME=                    # e.g. vz-abc123.b-cdn.net (Stream library pull zone, token auth ON)
BUNNY_WEBHOOK_SECRET=                  # random 32+ chars; webhook URL = /api/video/webhook?token=<secret>

# ---------- Payments ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Email ----------
RESEND_API_KEY=
EMAIL_FROM="GlobalMed <no-reply@globalmedtranscriptions.com>"
ADMIN_NOTIFY_EMAIL=                    # sales inbox for new leads
RESEND_SEGMENT_ID=                     # newsletter segment (Resend v6 "segments")
NEWSLETTER_SECRET=                     # random 32+ chars, signs newsletter confirmation links

# ---------- AI chatbot (client-supplied LLM) ----------
LLM_PROVIDER=                         # e.g. openai | anthropic | gemini
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=

# ---------- WhatsApp Cloud API ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Rate limiting ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Anti-spam ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Local development only ----------
FORMS_DRY_RUN=false                    # true = forms succeed without storing/emailing (ignored in production)

# ---------- Monitoring & analytics ----------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=                    # CI/Vercel only, for source map upload
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------- Tooling (developer shell only, not read by the app) ----------
# SUPABASE_ACCESS_TOKEN=              # Supabase MCP / CLI (npx supabase link)
# SUPABASE_PROJECT_REF=               # Supabase MCP (.mcp.json)
# TWENTYFIRST_API_KEY=                # 21st.dev Magic MCP (.mcp.json)

# ---------- Site ----------
NEXT_PUBLIC_WHATSAPP_NUMBER=               # optional override; defaults to the client number 923004198760 (lib/site.ts)
NEXT_PUBLIC_FEATURE_AAPC=false            # true only after AAPC written permission
